{
  "name": "napstr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "prebundle": "node scripts/prepare-tor-bundle.mjs",
    "bundle": "tauri build",
    "appimage:build": "bash scripts/build-appimage-local.sh build",
    "appimage:run": "bash scripts/build-appimage-local.sh launch",
    "appimage:test-user": "bash scripts/run-appimage-test-user.sh",
    "appimage": "bash scripts/build-appimage-local.sh run",
    "i18n:extract": "node scripts/i18n.mjs --extract",
    "i18n:check": "node scripts/i18n.mjs",
    "website:build": "node website/build.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.3.1",
    "parse5": "^8.0.1",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "@napstr/i18n": "file:shared/i18n",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.2.1",
    "@tauri-apps/plugin-os": "^2.3.2"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    }
  }
}
